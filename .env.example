DAKARBOT_TOKEN=your-bot-token-here
DAKARBOT_OWNER_IDS=123456789012345678

# For local testing: scopes all slash commands to this guild so they sync instantly
# instead of waiting up to an hour for global propagation. Leave unset in production.
# DAKARBOT_DEBUG_GUILD_IDS=123456789012345678

# Channel that receives error and warning reports. Leave unset locally.
# DAKARBOT_ERROR_CHANNEL_ID=123456789012345678

# Where /suggest posts and the command usage log go. Both default to the error channel.
# DAKARBOT_SUGGESTIONS_CHANNEL_ID=123456789012345678
# DAKARBOT_COMMAND_LOG_CHANNEL_ID=123456789012345678

# Support server link on /about.
# DAKARBOT_SUPPORT_URL=https://discord.gg/uVzKhQbcbM

DAKARBOT_DATABASE_HOST=localhost
DAKARBOT_DATABASE_PORT=5432
DAKARBOT_DATABASE_USER=dakarbot
DAKARBOT_DATABASE_PASSWORD=changeme
DAKARBOT_DATABASE_DATABASE=dakarbot

# Optional, added as their cogs are ported:
# DAKARBOT_GOOGLE_CREDENTIALS=<base64-encoded GCP service account JSON>
# DAKARBOT_GOOGLE_API_KEY=
